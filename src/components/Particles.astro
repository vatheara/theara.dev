---
interface Props {
  className?: string;
  quantity?: number;
  staticity?: number;
  ease?: number;
}

const {
  className = '',
  quantity = 100,
  staticity = 50,
  ease = 50,
} = Astro.props;
---

<div
  class:list={['particles-wrapper', className]}
  data-quantity={quantity}
  data-staticity={staticity}
  data-ease={ease}
  aria-hidden="true"
>
  <canvas class="particles-canvas w-full h-full"></canvas>
</div>

<script>
  function setupParticles() {
    const containers = document.querySelectorAll<HTMLDivElement>('.particles-wrapper');
    containers.forEach((container) => {
      // Avoid duplicate initialization on the same container
      if (container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      const canvas = container.querySelector<HTMLCanvasElement>('.particles-canvas');
      if (!canvas) return;

      const context = canvas.getContext('2d');
      if (!context) return;

      const quantity = parseInt(container.dataset.quantity || '100', 10);
      const staticity = parseInt(container.dataset.staticity || '50', 10);
      const ease = parseInt(container.dataset.ease || '50', 10);

      const dpr = typeof window !== 'undefined' ? window.devicePixelRatio || 1 : 1;
      let w = container.offsetWidth || window.innerWidth;
      let h = container.offsetHeight || window.innerHeight;
      const mouse = { x: 0, y: 0 };
      let mousePos = { x: 0, y: 0 };

      interface Circle {
        x: number;
        y: number;
        translateX: number;
        translateY: number;
        size: number;
        alpha: number;
        targetAlpha: number;
        dx: number;
        dy: number;
        magnetism: number;
      }

      let circles: Circle[] = [];

      const createCircle = (): Circle => {
        return {
          x: Math.floor(Math.random() * (w || window.innerWidth || 800)),
          y: Math.floor(Math.random() * (h || window.innerHeight || 600)),
          translateX: 0,
          translateY: 0,
          size: Math.floor(Math.random() * 2) + 0.2,
          alpha: 0,
          targetAlpha: parseFloat((Math.random() * 0.6 + 0.1).toFixed(1)),
          dx: (Math.random() - 0.5) * 0.2,
          dy: (Math.random() - 0.5) * 0.2,
          magnetism: 0.1 + Math.random() * 4,
        };
      };

      const resizeCanvas = () => {
        w = container.offsetWidth || window.innerWidth;
        h = container.offsetHeight || window.innerHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = `${w}px`;
        canvas.style.height = `${h}px`;
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        circles = [];
        for (let i = 0; i < quantity; i++) {
          circles.push(createCircle());
        }
      };

      const drawCircle = (circle: Circle) => {
        const { x, y, translateX, translateY, size, alpha } = circle;
        context.translate(translateX, translateY);
        context.beginPath();
        context.arc(x, y, size, 0, 2 * Math.PI);
        context.fillStyle = `rgba(255, 255, 255, ${alpha})`;
        context.fill();
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const onMouseMove = (e: MouseEvent) => {
        mousePos = { x: e.clientX, y: e.clientY };
        const rect = canvas.getBoundingClientRect();
        const x = mousePos.x - rect.left - w / 2;
        const y = mousePos.y - rect.top - h / 2;
        if (x < w / 2 && x > -w / 2 && y < h / 2 && y > -h / 2) {
          mouse.x = x;
          mouse.y = y;
        }
      };

      let animationId: number;

      const animate = () => {
        context.clearRect(0, 0, w, h);
        for (let i = 0; i < circles.length; i++) {
          const circle = circles[i];
          const edgeDist = Math.min(
            circle.x + circle.translateX - circle.size,
            w - circle.x - circle.translateX - circle.size,
            circle.y + circle.translateY - circle.size,
            h - circle.y - circle.translateY - circle.size
          );
          const remap = Math.max(0, Math.min(1, edgeDist / 20));
          if (remap >= 1) {
            circle.alpha = Math.min(circle.targetAlpha, circle.alpha + 0.02);
          } else {
            circle.alpha = circle.targetAlpha * remap;
          }

          circle.x += circle.dx;
          circle.y += circle.dy;
          circle.translateX +=
            (mouse.x / (staticity / circle.magnetism) - circle.translateX) / ease;
          circle.translateY +=
            (mouse.y / (staticity / circle.magnetism) - circle.translateY) / ease;

          if (
            circle.x < -circle.size ||
            circle.x > w + circle.size ||
            circle.y < -circle.size ||
            circle.y > h + circle.size
          ) {
            circles[i] = createCircle();
          } else {
            drawCircle(circle);
          }
        }
        animationId = requestAnimationFrame(animate);
      };

      resizeCanvas();
      animate();

      window.addEventListener('resize', resizeCanvas);
      window.addEventListener('mousemove', onMouseMove, { passive: true });

      document.addEventListener(
        'astro:before-swap',
        () => {
          window.removeEventListener('resize', resizeCanvas);
          window.removeEventListener('mousemove', onMouseMove);
          cancelAnimationFrame(animationId);
        },
        { once: true }
      );
    });
  }

  setupParticles();
  document.addEventListener('astro:page-load', setupParticles);
</script>
