---
interface Props {
  title?: string;
  description?: string;
  href?: string;
  logo?: string;
  tags?: { label: string; variant?: 'default' | 'primary' | 'success' }[];
}

const {
  title = 'KhmerGPT',
  description = 'Discover & Share with AI-powered Tools',
  href = 'https://chat.domnossrai.com/',
  logo = '/assets/logo/khmergpt.png',
  tags = [
    { label: 'free', variant: 'default' },
    { label: 'PWA', variant: 'primary' },
  ],
} = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative block w-full rounded-2xl border border-zinc-800/80 bg-zinc-900/60 p-6 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-zinc-700 hover:bg-zinc-900/90 hover:shadow-2xl hover:shadow-zinc-950/80 sm:p-8"
>
  <!-- Ambient subtle gradient glow on hover -->
  <div
    class="pointer-events-none absolute -inset-px rounded-2xl bg-gradient-to-r from-zinc-700/20 via-zinc-500/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
  >
  </div>

  <div class="relative flex flex-col sm:flex-row sm:items-center gap-6">
    <!-- App Logo with rounded frame -->
    <div
      class="flex h-24 w-24 sm:h-28 sm:w-28 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950/80 p-2 shadow-inner group-hover:border-zinc-700 transition-colors duration-300"
    >
      <img
        src={logo}
        alt={title}
        width="112"
        height="112"
        class="h-full w-full object-contain rounded-xl transition-transform duration-300 group-hover:scale-105"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- App Info -->
    <div class="flex flex-1 flex-col justify-between space-y-3">
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <h3
            class="text-2xl sm:text-3xl font-bold tracking-tight text-white transition-colors duration-200 group-hover:text-zinc-100"
          >
            {title}
          </h3>
          <!-- External Link Icon -->
          <svg
            class="h-5 w-5 text-zinc-500 transition-all duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-zinc-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </div>
        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Badges -->
      <div class="flex flex-wrap items-center gap-2 pt-1">
        {
          tags.map((tag) => (
            <span
              class={`inline-flex items-center rounded-full px-3 py-0.5 text-xs font-semibold tracking-wide uppercase ${
                tag.variant === 'primary'
                  ? 'bg-blue-950/60 text-blue-400 border border-blue-800/50'
                  : 'bg-zinc-800/80 text-zinc-300 border border-zinc-700/50'
              }`}
            >
              {tag.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</a>
