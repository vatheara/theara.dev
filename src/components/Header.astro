---
import { siteConfig } from '@/data/site';

interface Props {
  showBackButton?: boolean;
}

const { showBackButton = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="sticky top-6 z-50 flex items-center justify-center w-full px-4 mb-8">
  <nav class="flex items-center gap-1 sm:gap-2 px-3 py-1.5 rounded-full border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-xl shadow-lg shadow-black/40">
    {
      showBackButton && (
        <a
          href="/"
          class="inline-flex items-center gap-1 text-xs sm:text-sm font-medium text-zinc-400 hover:text-white px-2.5 py-1 rounded-full transition-colors duration-200 group"
          aria-label="Back to home"
        >
          <svg
            class="h-3.5 w-3.5 transition-transform duration-200 group-hover:-translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span class="hidden sm:inline">Home</span>
        </a>
      )
    }

    {
      siteConfig.nav.map((item) => {
        const isActive =
          item.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(item.href);

        return (
          <a
            href={item.href}
            class:list={[
              'text-xs sm:text-sm font-medium tracking-wide transition-all duration-200 px-3 py-1 rounded-full',
              isActive
                ? 'bg-zinc-800 text-white shadow-sm shadow-zinc-950'
                : 'text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/40',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.name}
          </a>
        );
      })
    }

    <div class="h-4 w-px bg-zinc-800 mx-1 hidden sm:block"></div>

    <a
      href={siteConfig.links.github}
      target="_blank"
      rel="noopener noreferrer"
      class="text-zinc-400 hover:text-white p-1.5 rounded-full hover:bg-zinc-800/40 transition-colors hidden sm:inline-flex"
      aria-label="GitHub Profile"
    >
      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
        ></path>
      </svg>
    </a>
  </nav>
</header>
