---
import Layout from '@/layouts/Layout.astro';
import Particles from '@/components/Particles.astro';
import { siteConfig } from '@/data/site';

const navigation = siteConfig.nav;
---

<Layout title="theara.dev" description={siteConfig.description}>
  <main class="relative flex flex-col items-center justify-between min-h-screen w-screen overflow-hidden bg-gradient-to-tl from-black via-zinc-900/20 to-black px-4 py-8 sm:py-12">
    <!-- Top Navigation -->
    <header class="w-full max-w-2xl flex flex-col items-center gap-4 animate-fade-in z-20">
      <!-- Status Pill -->
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-3 py-1 text-xs font-medium text-zinc-300 bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 rounded-full backdrop-blur-md transition-all duration-200 group"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>{siteConfig.status.message}</span>
        <svg
          class="h-3 w-3 text-zinc-500 group-hover:translate-x-0.5 group-hover:text-zinc-300 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Main Navigation Menu -->
      <nav aria-label="Main Navigation">
        <ul class="flex items-center justify-center gap-2 sm:gap-4 p-1 rounded-full border border-zinc-800/80 bg-zinc-950/60 backdrop-blur-xl">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'text-xs sm:text-sm font-medium tracking-wide transition-colors duration-200 px-3 sm:px-4 py-1.5 rounded-full',
                    item.href === '/'
                      ? 'text-white bg-zinc-800/80'
                      : 'text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/40',
                  ]}
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <!-- Center Hero Section -->
    <div class="flex flex-col items-center justify-center my-auto z-10 text-center select-none py-8">
      <!-- Top Glowing Line -->
      <div
        class="w-screen max-w-4xl h-px animate-glow md:block animate-fade-left bg-gradient-to-r from-zinc-300/0 via-zinc-300/40 to-zinc-300/0 mb-8 sm:mb-12"
      >
      </div>

      <!-- Main Display Title -->
      <h1
        class="text-5xl sm:text-7xl md:text-9xl font-bold tracking-tight text-transparent duration-1000 bg-white cursor-default text-edge-outline animate-title font-display whitespace-nowrap bg-clip-text drop-shadow-sm px-4"
      >
        theara
      </h1>

      <!-- Bottom Glowing Line -->
      <div
        class="w-screen max-w-4xl h-px animate-glow md:block animate-fade-right bg-gradient-to-r from-zinc-300/0 via-zinc-300/40 to-zinc-300/0 mt-8 sm:mt-12"
      >
      </div>

      <!-- Subtitle & Quick Overview -->
      <div class="mt-8 sm:mt-12 text-center animate-fade-in max-w-lg px-4 space-y-4">
        <p class="text-sm sm:text-base text-zinc-300 font-light leading-relaxed">
          Founder of{' '}
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://chat.domnossrai.com/"
            class="font-medium text-white underline underline-offset-4 decoration-zinc-600 hover:decoration-white transition-all duration-200"
          >
            KhmerGPT
          </a>
          ,{' '}
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://fotofast.theara.dev"
            class="font-medium text-white underline underline-offset-4 decoration-zinc-600 hover:decoration-white transition-all duration-200"
          >
            FotoFast
          </a>{' '}
          &{' '}
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="https://domlai.app"
            class="font-medium text-white underline underline-offset-4 decoration-zinc-600 hover:decoration-white transition-all duration-200"
          >
            Domlai
          </a>
          . Building AI-powered software to deliver the benefits of modern technology to humanity.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="/apps"
            class="inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-medium text-white bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-full transition-all duration-200 shadow-md hover:scale-105"
          >
            <span>Explore Apps</span>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/about"
            class="inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-medium text-zinc-300 hover:text-white bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 rounded-full transition-all duration-200"
          >
            <span>About Me</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Particle Background -->
    <Particles
      className="absolute inset-0 -z-10 animate-fade-in"
      quantity={90}
    />

    <!-- Bottom Socials / Quick Contact Bar -->
    <footer class="w-full max-w-md flex items-center justify-center gap-6 animate-fade-in z-20 text-xs text-zinc-500 pt-6">
      <a
        href={siteConfig.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-zinc-300 transition-colors flex items-center gap-1.5"
      >
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
      <span class="text-zinc-800">•</span>
      <a
        href={siteConfig.links.twitter}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-zinc-300 transition-colors flex items-center gap-1.5"
      >
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
        <span>Twitter / X</span>
      </a>
      <span class="text-zinc-800">•</span>
      <a
        href="/contact"
        class="hover:text-zinc-300 transition-colors flex items-center gap-1.5"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Contact</span>
      </a>
    </footer>
  </main>
</Layout>
