---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Particles from '@/components/Particles.astro';
import SpotlightCard from '@/components/SpotlightCard.astro';
import CopyEmail from '@/components/CopyEmail.astro';
import { siteConfig } from '@/data/site';
---

<Layout title="Contact" description="Get in touch with Theara for AI consulting, collaborations, or product development.">
  <div class="relative min-h-screen bg-gradient-to-tl from-black via-zinc-950/40 to-black flex flex-col justify-between">
    <!-- Particle Background -->
    <Particles
      className="fixed inset-0 -z-10 opacity-50"
      quantity={60}
    />

    <!-- Universal Navigation Header -->
    <Header showBackButton={true} />

    <!-- Main Content Container -->
    <main class="container mx-auto max-w-4xl px-6 py-8 sm:py-12 flex-1 space-y-12">
      <!-- Page Header -->
      <header class="space-y-4 text-center sm:text-left animate-fade-in">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-zinc-900 border border-zinc-800 text-zinc-400">
          <span>Contact & Collaboration</span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white font-display">
          Let's start a conversation.
        </h1>
        <p class="text-base sm:text-lg text-zinc-400 max-w-xl leading-relaxed">
          I'm always open to discussing new projects, artificial intelligence innovations, or opportunities to collaborate.
        </p>
      </header>

      <!-- Direct Contact Methods Grid -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-6 animate-fade-in">
        <!-- Email Card -->
        <SpotlightCard className="p-6 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <div class="h-10 w-10 rounded-xl bg-zinc-800/80 flex items-center justify-center text-zinc-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white font-display">Email</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Best way for formal inquiries, consulting, or project collaborations.
            </p>
          </div>
          <div class="pt-2">
            <CopyEmail email={siteConfig.links.email} />
          </div>
        </SpotlightCard>

        <!-- GitHub Card -->
        <SpotlightCard
          as="a"
          href={siteConfig.links.github}
          target="_blank"
          rel="noopener noreferrer"
          className="p-6 flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2">
            <div class="h-10 w-10 rounded-xl bg-zinc-800/80 flex items-center justify-center text-zinc-300">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white font-display">GitHub</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Explore open-source repositories, experiments, and contributions.
            </p>
          </div>
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-300 group-hover:text-white pt-2">
            <span>@vatheara</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </SpotlightCard>

        <!-- Twitter / X Card -->
        <SpotlightCard
          as="a"
          href={siteConfig.links.twitter}
          target="_blank"
          rel="noopener noreferrer"
          className="p-6 flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2">
            <div class="h-10 w-10 rounded-xl bg-zinc-800/80 flex items-center justify-center text-zinc-300">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white font-display">X / Twitter</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Follow along for AI development updates, product releases, and thoughts.
            </p>
          </div>
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-300 group-hover:text-white pt-2">
            <span>@vatheara</span>
            <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </SpotlightCard>
      </section>

      <!-- Quick Message Launcher Section -->
      <section class="p-6 sm:p-8 rounded-2xl border border-zinc-800/80 bg-zinc-900/40 backdrop-blur-xl animate-fade-in space-y-6">
        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-bold text-white font-display">Send a Quick Message</h2>
          <p class="text-xs sm:text-sm text-zinc-400">
            Fill out the fields below and click "Prepare Email" to instantly generate a pre-filled email in your favorite client.
          </p>
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="name" class="block text-xs font-medium text-zinc-300">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="e.g. Alex"
                required
                class="w-full px-4 py-2.5 rounded-xl bg-zinc-950/70 border border-zinc-800 focus:border-zinc-500 focus:outline-none text-sm text-white placeholder-zinc-600 transition-colors"
              />
            </div>
            <div class="space-y-1.5">
              <label for="subject" class="block text-xs font-medium text-zinc-300">Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                placeholder="e.g. AI Project Collaboration"
                required
                class="w-full px-4 py-2.5 rounded-xl bg-zinc-950/70 border border-zinc-800 focus:border-zinc-500 focus:outline-none text-sm text-white placeholder-zinc-600 transition-colors"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="message" class="block text-xs font-medium text-zinc-300">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Tell me about your project, idea, or inquiry..."
              required
              class="w-full px-4 py-2.5 rounded-xl bg-zinc-950/70 border border-zinc-800 focus:border-zinc-500 focus:outline-none text-sm text-white placeholder-zinc-600 transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3 text-sm font-medium text-white bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-xl transition-all duration-200 shadow-md hover:scale-[1.02] cursor-pointer"
          >
            <span>Launch Email Client</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>
      </section>

      <!-- Additional Details Card -->
      <section class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-zinc-400 animate-fade-in">
        <div class="p-4 rounded-xl border border-zinc-800/60 bg-zinc-900/20 space-y-1">
          <div class="text-zinc-200 font-medium">📍 Location & Timezone</div>
          <p>Phnom Penh, Cambodia (UTC+7 Indochina Time)</p>
        </div>
        <div class="p-4 rounded-xl border border-zinc-800/60 bg-zinc-900/20 space-y-1">
          <div class="text-zinc-200 font-medium">⚡ Response Time</div>
          <p>Typically replies within 24 hours on weekdays</p>
        </div>
      </section>
    </main>

    <!-- Universal Footer -->
    <Footer />
  </div>
</Layout>

<script>
  function setupContactForm() {
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (form.querySelector<HTMLInputElement>('#name')?.value || '').trim();
      const subject = (form.querySelector<HTMLInputElement>('#subject')?.value || '').trim();
      const message = (form.querySelector<HTMLTextAreaElement>('#message')?.value || '').trim();

      const fullSubject = encodeURIComponent(`[theara.dev] ${subject} - from ${name}`);
      const fullBody = encodeURIComponent(`Hi Theara,\n\n${message}\n\nBest regards,\n${name}`);
      window.location.href = `mailto:theara2048@gmail.com?subject=${fullSubject}&body=${fullBody}`;
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
